#!/bin/sh

echo "push"

# push 를 하면 build, test 등을 실행할 것인지, 안하고 바로 push 할 것인지 선택하게 해줍시다.
# y를 누르면 build, test 를 실행하고, n을 누르면 바로 push 합니다.
read -p "Do you want to run build and test before push? (y/n): " answer

if [[ "$answer" != "y" && "$answer" != "Y" ]]; then
    echo "Skipping build and test. Proceeding with push..."
    exit 0
fi

npm run build || exit 1
npm run test || exit 1
echo "build complete"
codex exec "가장 최근 push한 이후 변경된 파일들을 커밋기록을 통해 확인하고, 어떤 작업을 했는지 요약하여 dev/log/$(date +%Y-%m-%d)_push.md 에 작성해주세요."
echo "codex file write complete"
echo "Proceeding with push..."