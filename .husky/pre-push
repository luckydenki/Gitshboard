#!/bin/sh

printf "푸쉬 전에 build 테스트를 실행할까요? (y/n): "
read answer </dev/tty

# push 를 하면 build, test 등을 실행할 것인지, 안하고 바로 push 할 것인지 선택하게 해줍시다.
# y를 누르면 build, test 를 실행하고, n을 누르면 바로 push 합니다.



case "$answer" in
  y|Y)
    echo "Build를 실행합니다..."

    npm run build || exit 1
    npm run test || exit 1
    echo "build complete"
    codex exec "가장 최근 push한 이후 변경된 파일들을 커밋기록을 통해 확인하고, 어떤 작업을 했는지 요약하여 dev/log/[yymmdd]_push.md 에 작성해주세요."
    echo "codex file write complete"
    echo "Proceeding with push..."

    echo "Build가 성공했습니다."
    ;;
  n|N)
    echo "Build를 건너뛰고 푸쉬를 진행합니다."
    ;;
  *)
    echo "y 또는 n만 입력해주세요. 푸쉬를 중단합니다."
    exit 1
    ;;
esac

exit 0