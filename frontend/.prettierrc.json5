{
  "$schema": "https://json.schemastore.org/prettierrc",
  "printWidth": 100,
  "tabWidth": 4,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "bracketSameLine": true,
  "bracketSpacing": true,
  "arrowParens": "always",        // 화살표 함수의 매개변수에 항상 괄호를 사용
  "objectWrap": "preserve",       // 객체 래핑 방식을 유지
  "singleAttributePerLine": true, // 각 속성을 별도의 줄에 배치


  "plugins": ["prettier-plugin-tailwindcss"],
  "tailwindFunctions": ["tv", "cn", "clsx"]
}
